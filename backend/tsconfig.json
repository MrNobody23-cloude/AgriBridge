{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "../frontend/src/*"
            ]
        }
    },
    "include": [
        "test/**/*.ts",
        "scripts/**/*.ts",
        "vitest.config.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}