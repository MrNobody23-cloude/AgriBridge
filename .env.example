# ============================================
# AgriBridge AI — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# --------------------------------------------
# Database — MongoDB (the only database this project uses)
# --------------------------------------------
# Local development — a `mongod` on the default port:
MONGODB_URI="mongodb://127.0.0.1:27017/agribridge_ai"
#
# MongoDB Atlas (free M0) — the app is written to work identically on both.
# Two Atlas-specific things the code already handles, so nothing extra is
# needed here beyond pasting your own URI:
#   * `maxPoolSize: 1` in src/lib/db/connection.ts. Atlas M0 allows 5
#     concurrent connections in total across the whole project, and a serverless
#     deploy opens a new one per function instance, so an uncached pool
#     exhausts the limit and the app fails with a timeout rather than a
#     connection error.
#   * No replica set on M0, so multi-document transactions are unavailable.
#     None are used: there were none under Prisma either.
#
# After pointing this at a new database, load the demo data once with:
#   npm run seed:test-users
# The original SQLite rows were a one-time import (`prisma/dev.db`); that file
# is no longer part of the project and Prisma is no longer a dependency.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.XXXXXX.mongodb.net/agribridge_ai?retryWrites=true&w=majority"

# --------------------------------------------
# Authentication
# Generate with: openssl rand -base64 64
# --------------------------------------------
AUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# --------------------------------------------
# Application URLs
# --------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"
AI_SERVICE_URL="http://localhost:8000"

# CORS — comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000"

# --------------------------------------------
# Blockchain — Polygon Amoy Testnet
# --------------------------------------------
# There is no on/off switch. The chain is used when a contract address and a
# signer are both present, and skipped — with the batch marked NOT_CONFIGURED
# — when they are not. An earlier BLOCKCHAIN_MODE=mock generated deterministic
# SHA-256 hashes and reported them as chain transactions, which is why the
# variable is gone: there is no longer any code path that fabricates a proof.
#
# Until you fill in PRIVATE_KEY and CONTRACT_ADDRESS below, batches are NOT
# written to any chain and on-chain verification reports NOT_CONFIGURED.
# GET /api/health reports this as services.blockchain.status = not_configured.

POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"

# ⚠️ Your Ethereum/Polygon wallet private key — NEVER share or commit
PRIVATE_KEY=""

# Deployed AgriBridgeTraceability contract address (after running: npx hardhat run scripts/deploy.js --network amoy)
CONTRACT_ADDRESS=""

# --------------------------------------------
# IPFS — Pinata
# Get keys at: https://app.pinata.cloud/developers/api-keys
# --------------------------------------------
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""
PINATA_GATEWAY_URL="https://gateway.pinata.cloud"

# --------------------------------------------
# AI / LLM — Google Gemini
# Get key at: https://aistudio.google.com/app/apikey
# --------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional OpenAI fallback
OPENAI_API_KEY=""

# --------------------------------------------
# Email Notifications (SMTP)
# --------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@agribridge.ai"

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# --------------------------------------------
# File Upload
# --------------------------------------------
MAX_FILE_SIZE_MB="10"
ALLOWED_FILE_TYPES="application/pdf,image/jpeg,image/png,image/webp"