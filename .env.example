# ============================================
# AgriBridge AI — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# --------------------------------------------
# Database (PostgreSQL recommended for prod)
# --------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agribridge_ai"
# For local SQLite dev only:
# DATABASE_URL="file:./dev.db"

# --------------------------------------------
# Authentication
# Generate with: openssl rand -base64 64
# --------------------------------------------
AUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# --------------------------------------------
# Application URLs
# --------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"
AI_SERVICE_URL="http://localhost:8000"

# CORS — comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000"

# --------------------------------------------
# Blockchain — Polygon Amoy Testnet
# --------------------------------------------
# "mock" uses deterministic SHA-256 hashes (no wallet needed)
# "real" requires PRIVATE_KEY and deployed CONTRACT_ADDRESS
BLOCKCHAIN_MODE="mock"

POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"

# ⚠️ Your Ethereum/Polygon wallet private key — NEVER share or commit
PRIVATE_KEY=""

# Deployed AgriBridgeTraceability contract address (after running: npx hardhat run scripts/deploy.js --network amoy)
CONTRACT_ADDRESS=""

# --------------------------------------------
# IPFS — Pinata
# Get keys at: https://app.pinata.cloud/developers/api-keys
# --------------------------------------------
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""
PINATA_GATEWAY_URL="https://gateway.pinata.cloud"

# --------------------------------------------
# AI / LLM — Google Gemini
# Get key at: https://aistudio.google.com/app/apikey
# --------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional OpenAI fallback
OPENAI_API_KEY=""

# --------------------------------------------
# Email Notifications (SMTP)
# --------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@agribridge.ai"

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# --------------------------------------------
# File Upload
# --------------------------------------------
MAX_FILE_SIZE_MB="10"
ALLOWED_FILE_TYPES="application/pdf,image/jpeg,image/png,image/webp"
