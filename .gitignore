# ============================================
# AgriBridge AI — .gitignore
# ============================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/
**/coverage/

# Next.js
.next/
**/.next/
out/
**/out/

# Production build
build/
**/build/

# Misc
.DS_Store
*.pem

# ⚠️ NEVER commit these files
.env
.env.local
.env.development
.env.production
.env.test

# Database files — NEVER commit
prisma/dev.db
prisma/dev.db-journal
prisma/test.db
*.db
*.db-journal
*.db-wal
*.db-shm

# Python
ai-service/__pycache__/
ai-service/*.pyc
ai-service/.venv/
ai-service/venv/
ai-service/*.egg-info/
ai-service/dist/
ai-service/build/
ai-service/.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt

# Stray output from ad-hoc seed/pnpm runs
seed.out

# Vector store (auto-generated)
ai-service/vectorstore/
rag/vectorstore/

# IPFS upload temp dir
uploads/
tmp/

# Blockchain
blockchain/artifacts/
blockchain/cache/
hardhat/artifacts/
hardhat/cache/

# Hardhat output at the repo root. `hardhat.config.js` has no custom `paths`
# override, so the compiler writes here rather than under `hardhat/` — the four
# entries above only cover a `hardhat/` subdirectory that does not exist. These
# are regenerated by `npx hardhat compile`; the committed ABI that the app
# imports is `contracts/`, not this.
/artifacts/
/cache/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
Thumbs.db
