# ============================================
# AgriBridge AI — .gitignore
# ============================================

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/

# Next.js
.next/
out/

# Production build
build/

# Misc
.DS_Store
*.pem

# ⚠️ NEVER commit these files
.env
.env.local
.env.development
.env.production
.env.test

# Database files — NEVER commit
prisma/dev.db
prisma/dev.db-journal
prisma/test.db
*.db
*.db-journal
*.db-wal
*.db-shm

# Python
backend/ai-service/__pycache__/
backend/ai-service/*.pyc
backend/ai-service/.venv/
backend/ai-service/venv/
backend/ai-service/*.egg-info/
backend/ai-service/dist/
backend/ai-service/build/
backend/ai-service/.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt

# ML model artifacts
backend/ai-service/models/*.pkl
backend/ai-service/models/*.joblib
backend/ai-service/models/*.h5
backend/ai-service/models/*.pt
backend/ai-service/models/*.onnx
!backend/ai-service/models/README.md
!backend/ai-service/models/*.json

# The six trained agents under models/agents/ ARE committed.
!backend/ai-service/models/agents/
!backend/ai-service/models/agents/*.pkl
!backend/ai-service/models/agents/DIGESTS.json

# Agent training datasets and evaluation output
!backend/ai-service/results/
!backend/ai-service/results/data/
!backend/ai-service/results/data/*.csv

# Stray output from ad-hoc seed/pnpm runs
seed.out

# Vector store (auto-generated)
ai-service/vectorstore/
rag/vectorstore/
backend/ai-service/vectorstore/embeddings.npy

# IPFS upload temp dir
uploads/
tmp/

# Blockchain
blockchain/artifacts/
blockchain/cache/
hardhat/artifacts/
hardhat/cache/

# Hardhat output at the repo root. `hardhat.config.js` has no custom `paths`
# override, so the compiler writes here rather than under `hardhat/` — the four
# entries above only cover a `hardhat/` subdirectory that does not exist. These
# are regenerated by `npx hardhat compile`; the committed ABI that the app
# imports is `contracts/`, not this.
/artifacts/
/cache/
/backend/artifacts/
/backend/cache/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
Thumbs.db
